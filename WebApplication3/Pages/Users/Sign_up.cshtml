<div class="auth-wrapper">
    <div class="auth-card">
        <h3 class="text-center mb-3">Create Account</h3>
        <p class="text-center auth-subtitle mb-4">Join My BookStore today</p>

        <form method="post">

            <!-- Full Name -->
            <div class="mb-3">
                <label class="form-label">Full Name</label>
                <input type="text"
                       name="name"
                       class="form-control auth-input"
                       placeholder="Enter your full name"
                       value="@Model.NewUser.Name"
                       required />
            </div>

            <!-- Email -->
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email"
                       name="email"
                       class="form-control auth-input"
                       placeholder="Enter your email"
                       value="@Model.NewUser.Email"
                       required />
            </div>

            <!-- Password -->
            <div class="mb-3">
                <label class="form-label">Password</label>
                <input type="password"
                       name="password"
                       class="form-control auth-input"
                       placeholder="Create a password"
                       value="@Model.NewUser.Password"
                       required />
            </div>

            <!-- Register Button -->
            <button type="submit" class="btn auth-btn w-100">Register</button>

            <!-- Google Login -->
            <div class="google-wrapper mt-3">
                <a asp-page="/Users/Signin"
                   asp-page-handler="GoogleLogin"
                   class="btn google-btn w-100">
                    <img src="/img/google.png" class="google-icon" />
                    Or Sign in with Google
                </a>
            </div>

            <div class="text-center mt-3">
                <small>
                    Already have an account?
                    <a asp-page="/Users/Signin">Login here</a>
                </small>
            </div>

        </form>
    </div>
</div>
